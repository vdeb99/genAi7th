# Copy to .env and replace every value. Never commit .env.
GOOGLE_API_KEY=replace_with_your_google_ai_studio_key
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_a_long_unique_password
NEO4J_URI=bolt://neo4j:7687
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=multimodal_collection_v3
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
GEMINI_REQUESTS_PER_SECOND=0.2
MAX_UPLOAD_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
